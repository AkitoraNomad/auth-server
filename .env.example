# Backend runtime configuration. The server reads environment variables through
# config.yaml placeholders and the ADMIN_* overrides; it does not load .env
# itself. VS Code launch.json uses envFile for local runs.

DB=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable&search_path=auth
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# The management client is a fixed BIGINT client row. Starting the server takes
# over and updates this row (public client, empty secret, management scopes).
ADMIN_CLIENT_ID=2
ADMIN_CLIENT_DISPLAY_NAME=Auth Server Admin
ADMIN_CLIENT_REDIRECT_URIS=http://localhost:5173/admin-page/callback,http://127.0.0.1:5173/admin-page/callback,http://localhost:8080/admin-page/callback,http://127.0.0.1:8080/admin-page/callback
ADMIN_CLIENT_SCOPES=manage:system,manage:clients
ADMIN_CLIENT_GRANT_TYPES=authorization_code,refresh_token

# Browser origin used by discovery, JWT iss and same-origin checks.
# Vite development proxy: localhost:5173; standalone Go: localhost:8080.
# Override with the public HTTPS origin in production.
OAUTH_ISSUER=http://localhost:5173
