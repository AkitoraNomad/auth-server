# Public SPA configuration. Never put a client secret in a VITE_* variable.

# Must match the numeric auth_client id seeded by the backend (default: 2).
VITE_ADMIN_CLIENT_ID=2

# Empty means the current origin. In development Vite proxies /oauth2 and /api
# to the backend, so same-origin is the recommended setup.
VITE_AUTH_BASE_URL=
VITE_API_BASE_URL=

# Optional override. Defaults to <current origin>/admin-page/callback and must
# exactly match one of the backend ADMIN_CLIENT_REDIRECT_URIS values.
VITE_ADMIN_REDIRECT_URI=
