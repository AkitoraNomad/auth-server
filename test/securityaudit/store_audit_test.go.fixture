// A real, correctly signed credential for fixture identity 111. No production
// bot key or victim credential is used or read.
func signedCredential(authDate int64) json.RawMessage {
	key := sha256.Sum256([]byte("audit-only-bot-key"))
	message := fmt.Sprintf("auth_date=%d\nfirst_name=Attacker\nid=111", authDate)
	mac := hmac.New(sha256.New, key[:])
	mac.Write([]byte(message))
	raw, _ := json.Marshal(map[string]any{"id": int64(111), "first_name": "Attacker", "auth_date": authDate, "hash": hex.EncodeToString(mac.Sum(nil))})
	return raw
}

type identityDriver struct{}
type identityConn struct{}

var identityUserVersion int64
var identityPasswordData []byte

func (identityDriver) Open(string) (driver.Conn, error)  { return identityConn{}, nil }
func (identityConn) Prepare(string) (driver.Stmt, error) { return nil, fmt.Errorf("not implemented") }
func (identityConn) Close() error                        { return nil }
func (identityConn) Begin() (driver.Tx, error)           { return nil, fmt.Errorf("not implemented") }
func (identityConn) QueryContext(_ context.Context, query string, args []driver.NamedValue) (driver.Rows, error) {
	if strings.Contains(query, "from auth_user_provider p join auth_user") {
		providerType, data := "Telegram", []byte(`{}`)
		if args[1].Value == "EmailPassword" {
			providerType, data = "EmailPassword", identityPasswordData
		} else if args[0].Value != "222" && args[0].Value != "111" {
			return nil, fmt.Errorf("unexpected selected identity")
		}
		return &identityRows{columns: []string{"id", "user_id", "login_key", "provider_type", "provider_data", "user_security_version"}, values: []driver.Value{int64(1), int64(42), fmt.Sprint(args[0].Value), providerType, data, int64(0)}}, nil
	}
	if query == "select * from auth_user where id = $1" {
		return &identityRows{columns: []string{"id", "email", "display_name", "last_login_at", "security_version"}, values: []driver.Value{int64(42), "victim@example.invalid", "Victim", nil, identityUserVersion}}, nil
	}
	return nil, fmt.Errorf("unexpected query: %s", query)
}

type identityRows struct {
	columns []string
	values  []driver.Value
	done    bool
}

func (r *identityRows) Columns() []string { return r.columns }
func (r *identityRows) Close() error      { return nil }
func (r *identityRows) Next(dest []driver.Value) error {
	if r.done {
		return io.EOF
	}
	copy(dest, r.values)
	r.done = true
	return nil
}

func TestTelegramCredentialMustMatchSelectedAccount(t *testing.T) {
	sql.Register("audit-identity", identityDriver{})
	db, err := sql.Open("audit-identity", "")
	if err != nil {
		t.Fatal(err)
	}
	defer db.Close()
	internal.DB = sqlx.NewDb(db, "audit-identity")
	internal.AuthServerConfig.Telegram.BotToken = "audit-only-bot-key"
	mgr := session.NewManager()
	req := httptest.NewRequest("GET", "https://auth.example.invalid/login", nil)
	sess, err := mgr.Start(context.Background(), httptest.NewRecorder(), req)
	if err != nil {
		t.Fatal(err)
	}
	provider := model.ProviderTelegram
	user, err := (&DbUserStore{}).GetUserByCredentials("222", &provider, signedCredential(time.Now().Unix()), sess)
	if err == nil && user != nil {
		t.Fatalf("ACCOUNT TAKEOVER: signed Telegram id=111 authenticated selected login_key=222, user_id=%d", user.ID)
	}
}

func TestTelegramMustRejectExpiredCredential(t *testing.T) {
	key := sha256.Sum256([]byte("audit-only-bot-key"))
	if util.ValidateTelegramCredential(signedCredential(time.Now().Add(-365*24*time.Hour).Unix()), key[:]) {
		t.Fatal("one-year-old valid credential was accepted; no auth_date limit")
	}
}

func TestTelegramMalformedHashMustNotPanic(t *testing.T) {
	defer func() {
		if value := recover(); value != nil {
			t.Errorf("untrusted hash type causes panic: %v", value)
		}
	}()
	util.ValidateTelegramCredential(json.RawMessage(`{"id":111,"hash":123}`), []byte("fixture"))
}

func TestTelegramMatchingIdentityAndCanonicalReplayRejection(t *testing.T) {
	sql.Register("audit-positive-identity", identityDriver{})
	db, err := sql.Open("audit-positive-identity", "")
	if err != nil {
		t.Fatal(err)
	}
	oldDB, oldRedis, oldBot := internal.DB, internal.Rdb, internal.AuthServerConfig.Telegram.BotToken
	defer func() {
		internal.DB = oldDB
		internal.Rdb = oldRedis
		internal.AuthServerConfig.Telegram.BotToken = oldBot
		db.Close()
	}()
	internal.DB = sqlx.NewDb(db, "audit-positive-identity")
	internal.Rdb, _ = AuditRedisClient()
	internal.AuthServerConfig.Telegram.BotToken = "audit-only-bot-key"
	manager := session.NewManager()
	sess, err := manager.Start(context.Background(), httptest.NewRecorder(), httptest.NewRequest("GET", "https://auth.example.invalid/login", nil))
	if err != nil {
		t.Fatal(err)
	}
	provider := model.ProviderTelegram
	data := signedCredential(time.Now().Unix())
	user, err := (&DbUserStore{}).GetUserByCredentials("111", &provider, data, sess)
	if err != nil || user == nil {
		t.Fatalf("matching signed identity rejected: %v", err)
	}
	var reordered map[string]any
	if err := json.Unmarshal(data, &reordered); err != nil {
		t.Fatal(err)
	}
	replay, err := json.MarshalIndent(reordered, "", "  ")
	if err != nil {
		t.Fatal(err)
	}
	if _, err := (&DbUserStore{}).GetUserByCredentials("111", &provider, replay, sess); err == nil {
		t.Fatal("same credential reused by changing JSON representation")
	}
}

func TestCredentialVerificationRejectsConcurrentSecurityChange(t *testing.T) {
	sql.Register("audit-identity-version", identityDriver{})
	db, err := sqlx.Open("audit-identity-version", "")
	if err != nil {
		t.Fatal(err)
	}
	defer db.Close()
	old := internal.DB
	internal.DB = db
	defer func() { internal.DB = old; identityUserVersion = 0; identityPasswordData = nil }()
	hash, err := password.Hash("fixture-password-123")
	if err != nil {
		t.Fatal(err)
	}
	identityPasswordData, _ = json.Marshal(map[string]string{"password": hash})
	// Provider credentials were read at version 0; the account changes before
	// the post-verification read. Never attach the new version to old credentials.
	identityUserVersion = 1
	kind := model.ProviderEmailPassword
	user, err := (&DbUserStore{}).GetUserByCredentials("fixture@example.invalid", &kind, json.RawMessage(`{"password":"fixture-password-123"}`), nil)
	if err == nil || user != nil {
		t.Fatal("old credentials authenticated against a new account security version")
	}
}
