    classDef spa fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e;
    classDef server fill:#dcfce7,stroke:#16a34a,color:#14532d;
    classDef data fill:#fef3c7,stroke:#d97706,color:#78350f;
    classDef decision fill:#fef9c3,stroke:#ca8a04,color:#713f12;
    classDef ok fill:#bbf7d0,stroke:#15803d,color:#14532d;
    classDef error fill:#fee2e2,stroke:#dc2626,color:#7f1d1d;
    classDef note fill:#f1f5f9,stroke:#94a3b8,color:#334155;

    class S0 start;
    class S2,S3,S9,S10,S11,S12,S13,S14 spa;
    class S1,S10b decision;
    class A0,A1,A2,A4,A6,A7,A8,A10,A11,A12,A13,A14,A15,A16,A18 server;
    class A3,A5,A9,A17 decision;
    class A19 ok;
    class A20,A21,A22 error;
    class R1,R2,R3,P1 data;
    class N1 note;