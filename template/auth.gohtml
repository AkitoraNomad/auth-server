<!DOCTYPE html>
<html lang="en" class="auth-html">

<head>
    <title>Authorize access · Auth Server</title>
    <meta name="robots" content="noindex">
    {{template "head_common" .}}
    {{template "auth_head" .}}
</head>

<body class="auth-body">
    <main class="layout-main auth-main">
        <div class="auth-shell auth-shell--wide">
            <section class="card auth-card" aria-labelledby="auth-title">
                <div class="card-content">
                    <header class="auth-brand">
                        <span class="auth-logo" aria-hidden="true">🐯</span>
                        <div>
                            <p class="auth-eyebrow">Authorization request</p>
                            <h1 class="auth-title" id="auth-title">Authorize access</h1>
                        </div>
                    </header>

                    <p class="auth-subtitle">
                        <strong>{{.clientInfo.GetDisplayName}}</strong> is requesting access to your account.
                    </p>

                    {{if .error}}
                    <div class="notification is-danger is-light auth-alert" role="alert">{{.error}}</div>
                    {{end}}

                    <form action="/oauth2/authorize" method="POST" id="consentForm">
                        <input type="hidden" name="consent" value="1">
                        <input type="hidden" name="request_id" value="{{.requestID}}">
                        <input type="hidden" name="client_id" value="{{.clientInfo.GetID}}">
                        <input type="hidden" name="redirect_uri" value="{{.redirectURI}}">
                        <input type="hidden" name="response_type" value="{{.responseType}}">
                        <input type="hidden" name="state" value="{{.state}}">
                        <input type="hidden" name="code_challenge" value="{{.codeChallenge}}">
                        <input type="hidden" name="code_challenge_method" value="{{.codeChallengeMethod}}">

                        <p class="auth-label">Permissions requested</p>

                        <div class="auth-scope-list">
                            {{- range .scopeRequested }}
                            <label class="auth-scope">
                                <input type="checkbox" name="consented" value="{{.GetName}}" {{if .IsDefault}}checked{{end}}>
                                <span>
                                    <span class="auth-scope-name"><code>{{.GetName}}</code></span>
                                    {{if .GetDescription}}
                                    <span class="auth-scope-desc">{{.GetDescription}}</span>
                                    {{end}}
                                </span>
                            </label>
                            {{- end }}
                        </div>

                        <p class="auth-scope-hint">Only the permissions you select will be granted.</p>

                        <div class="auth-actions">
                            <button type="submit" class="button is-primary auth-submit">
                                <span>Allow access</span>
                                <i class="fas fa-check" aria-hidden="true"></i>
                            </button>
                            <button type="submit" name="deny" value="1" class="button auth-deny">
                                Deny
                            </button>
                        </div>
                    </form>

                    <p class="auth-footnote">
                        <i class="fas fa-shield-alt" aria-hidden="true"></i>
                        You can review and deny this request before continuing.
                    </p>
                </div>
            </section>
        </div>
    </main>

    {{template "auth_footer" .}}
</body>

</html>
