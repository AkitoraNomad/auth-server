<!DOCTYPE html>
<html lang="en" class="auth-html">

<head>
    <meta name="robots" content="noindex">
    <title>Sign in · Auth Server</title>
    {{template "head_common" .}}
    {{template "auth_head" .}}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>

<body class="auth-body">
    <main class="layout-main auth-main">
        <div class="auth-shell">
            <section class="card auth-card" aria-labelledby="auth-title">
                <div class="card-content">
                    <header class="auth-brand">
                        <span class="auth-logo" aria-hidden="true">🐯</span>
                        <div>
                            <p class="auth-eyebrow">Auth Server</p>
                            <h1 class="auth-title" id="auth-title">Welcome back</h1>
                        </div>
                    </header>

                    <p class="auth-subtitle">
                        Sign in to continue to <strong>{{.client_name}}</strong>.
                    </p>

                    <div id="msgDiv" class="auth-msg" aria-live="polite"></div>

                    <form action="/login" method="POST" id="loginForm"
                        data-next-url="{{.next_url}}" data-request-id="{{.request_id}}">
                        <div class="field">
                            <label class="label auth-label" for="email">Email address</label>
                            <div class="control has-icons-left">
                                <input class="input auth-input" type="email" name="email" id="email"
                                    placeholder="you@example.com" autocomplete="username" inputmode="email"
                                    autocapitalize="none" spellcheck="false" required>
                                <span class="icon is-small is-left">
                                    <i class="fas fa-envelope"></i>
                                </span>
                            </div>
                        </div>

                        <div class="field">
                            <label class="label auth-label" for="password">Password</label>
                            <div class="control has-icons-left">
                                <input class="input auth-input" type="password" name="password" id="password"
                                    placeholder="Enter your password" autocomplete="current-password" required>
                                <span class="icon is-small is-left">
                                    <i class="fas fa-lock"></i>
                                </span>
                            </div>
                        </div>

                        <div class="auth-turnstile">
                            <div class="cf-turnstile" data-sitekey="{{.site_key}}" data-theme="light"
                                data-callback="turnstileCallback"
                                data-error-callback="turnstileErrorCallback"
                                data-expired-callback="turnstileExpiredCallback"></div>
                        </div>
                        <p class="auth-help">Complete the verification to enable sign-in.</p>

                        <div class="field">
                            <button type="submit" class="button is-primary is-fullwidth auth-submit"
                                id="loginBtn" disabled>
                                <span>Sign in</span>
                                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                            </button>
                        </div>

                        <div class="auth-divider"><span>or</span></div>

                        <div class="field">
                            <button type="button" class="button is-fullwidth auth-secondary"
                                id="tgLoginBtn" disabled onclick="toggleTelegramModal(true)">
                                <i class="fab fa-telegram" aria-hidden="true"></i>
                                Continue with Telegram
                            </button>
                        </div>
                    </form>

                    <p class="auth-footnote">
                        <i class="fas fa-shield-alt" aria-hidden="true"></i>
                        Protected by Cloudflare Turnstile
                    </p>
                </div>
            </section>
        </div>
    </main>

    {{template "auth_footer" .}}

    <div class="modal" id="telegramModal" aria-hidden="true">
        <div class="modal-background" onclick="toggleTelegramModal(false)"></div>
        <div class="modal-content">
            <div class="card auth-modal-card">
                <div class="card-content">
                    <p class="auth-modal-title">Continue with Telegram</p>
                    <p class="auth-modal-text">
                        Authorize the Telegram bot to sign in. The verification above is required first.
                    </p>
                    <div class="auth-telegram-widget">
                        <script async src="https://telegram.org/js/telegram-widget.js?22"
                            data-telegram-login="{{.bot_name}}" data-size="large" data-onauth="onTelegramAuth(user)"
                            data-request-access="write"></script>
                    </div>
                </div>
            </div>
        </div>
        <button class="modal-close is-large" aria-label="Close Telegram dialog"
            onclick="toggleTelegramModal(false)"></button>
    </div>

    <script>
        /**
         * @typedef {Object} User
         * @property {number} id
         * @property {string} email
         * @property {string} display_name
         * @property {string} [last_login_at]
         */

        /**
         * @typedef {Object} TelegramUser
         * @property {string} first_name
         * @property {string} last_name
         * @property {number} id
         * @property {string} [username]
         */

        /** @type {string|undefined} */
        let cfToken = undefined;
        /** @type {TelegramUser|undefined} */
        let tgUser = undefined;

        window.turnstileCallback = function (token) {
            cfToken = token;
            setLoginBtnDisable(false);
            clearErrorMessage();
        };

        window.turnstileErrorCallback = function () {
            cfToken = undefined;
            setLoginBtnDisable(true);
            showErrorMessage("Verification failed. Please refresh and try again.");
        };

        window.turnstileExpiredCallback = function () {
            cfToken = undefined;
            setLoginBtnDisable(true);
            showErrorMessage("Verification expired. Please complete it again.");
        };

        function setLoginBtnDisable(disabled) {
            document.getElementById('loginBtn').disabled = disabled;
            document.getElementById('tgLoginBtn').disabled = disabled;
        }

        function clearErrorMessage() {
            document.getElementById('msgDiv').replaceChildren();
        }

        function showErrorMessage(message) {
            const container = document.getElementById('msgDiv');
            container.replaceChildren();

            const alert = document.createElement('div');
            alert.className = 'notification is-danger is-light auth-alert';
            alert.setAttribute('role', 'alert');

            const close = document.createElement('button');
            close.type = 'button';
            close.className = 'delete';
            close.setAttribute('aria-label', 'Dismiss error');
            close.addEventListener('click', () => alert.remove());

            alert.append(close, document.createTextNode(message));
            container.append(alert);
        }

        /**
         * @param {boolean} open
         */
        function toggleTelegramModal(open) {
            const modal = document.getElementById('telegramModal');
            modal.classList.toggle('is-active', open);
            modal.setAttribute('aria-hidden', String(!open));
        }

        /**
         * @param {TelegramUser} user
         */
        function onTelegramAuth(user) {
            tgUser = user;
            if (!cfToken) {
                showErrorMessage("Please complete the Turnstile challenge first.");
                toggleTelegramModal(false);
                return;
            }

            const formData = {
                provider_type: "Telegram",
                cf_token: cfToken,
                login_key: tgUser.id.toString(),
                data: tgUser
            };
            setLoginBtnDisable(true);
            toggleTelegramModal(false);
            loginReq(formData).then(payload => {
                if (!payload) {
                    return;
                }
                if (payload.code !== 0) {
                    showErrorMessage("Login failed. Please try again.");
                    return;
                }
                handleRedirect(payload.data.user, payload.data.next_url);
            }).finally(() => setLoginBtnDisable(false));
        }

        function nextUrl() {
            return document.getElementById('loginForm').dataset.nextUrl || "/auth";
        }

        function handleRedirect(user, next) {
            if (!user) {
                window.location.replace("/registration");
            } else {
                window.location.replace(next || nextUrl());
            }
        }

        document.getElementById('loginForm').addEventListener('submit', (event) => {
            const form = event.target;
            if (!form.checkValidity()) {
                event.preventDefault();
                return;
            }
            event.preventDefault();
            clearErrorMessage();

            const formData = {
                provider_type: "EmailPassword",
                cf_token: cfToken,
                login_key: form.email.value,
                data: {
                    password: form.elements["password"].value,
                }
            };
            setLoginBtnDisable(true);
            loginReq(formData)
                .then(payload => {
                    if (!payload) {
                        return;
                    }
                    if (payload.code !== 0) {
                        showErrorMessage("Login failed. Check your credentials and try again.");
                    } else if (!payload.data.user) {
                        showErrorMessage("Invalid credentials.");
                    } else {
                        handleRedirect(payload.data.user, payload.data.next_url);
                    }
                })
                .finally(() => setLoginBtnDisable(false));
        });

        function loginReq(body) {
            const requestId = document.getElementById('loginForm').dataset.requestId;
            body.request_id = requestId || undefined;
            return fetch("/login", {
                method: "POST",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(async response => {
                if (!response.ok) {
                    throw new Error("HTTP " + response.status);
                }
                return response.json();
            }).catch(() => {
                showErrorMessage("Network error. Please try again.");
                return null;
            });
        }
    </script>
</body>

</html>
