<!DOCTYPE html>
<html lang="zh">

<head>
    <title>Login</title>
    {{template "head_common" .}}
    <link href="https://cdn.bootcss.com/font-awesome/5.13.0/css/all.css" rel="stylesheet">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>

<body>
    {{template "navbar" .}}
    <main class="layout-main">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <div class="content">
                        <h1>🐯 Login In {{.client_name}}</h1>
                    </div>
                    <div id="msgDiv"></div>
                </div>
            </div>
            <div class="columns is-centered">
                <div class="column is-half">
                    <form action="/login" method="POST" id="loginForm" data-next-url="{{.next_url}}" data-request-id="{{.request_id}}">
                        <div class="field">
                            <label class="label" for="email">E-Mail</label>
                            <div class="control has-icons-left">
                                <input class="input" type="email" name="email" id="email"
                                    placeholder="e.g. hello@example.com" required>
                                <span class="icon is-small is-left">
                                    <i class="fas fa-envelope"></i>
                                </span>
                            </div>
                        </div>
                        <div class="field">
                            <p class="control has-icons-left">
                                <input class="input" type="password" name="password" placeholder="Password">
                                <span class="icon is-small is-left">
                                    <i class="fas fa-lock"></i>
                                </span>
                            </p>
                        </div>
                        <div class="cf-turnstile" data-sitekey="{{.site_key}}" data-callback="turnstileCallback"></div>
                        <div class="field">
                            <div class="control">
                                <button type="submit" class="button is-primary is-fullwidth" id="loginBtn"
                                    disabled>Login
                                </button>
                            </div>
                        </div>
                        <div class="field">
                            <div class="control">
                                <button type="button" class="button is-fullwidth" id="tgLoginBtn" disabled
                                    onclick="toggleTelegramModal(true)">Login By Telegram
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal" id="telegramModal">
                <div class="modal-background" onclick="toggleTelegramModal(false)"></div>
                <div class="modal-content">
                    <div class="card">
                        <div class="card-content">
                            <script async src="https://telegram.org/js/telegram-widget.js?22"
                                data-telegram-login="{{.bot_name}}" data-size="large" data-onauth="onTelegramAuth(user)"
                                data-request-access="write"></script>
                        </div>
                    </div>
                </div>
                <button class="modal-close is-large" aria-label="close" onclick="toggleTelegramModal(false)"></button>
            </div>
        </div>
    </main>
    {{template "footer" .}}

    <script>
        /**
         * @typedef {Object} User
         * @property {number} id - 用户的ID
         * @property {string} email - 用户的邮箱
         * @property {string} display_name - 用户的显示名称
         * @property {string} [last_login_at] - 上次登录时间
         */

        /**
         * @typedef {Object} TelegramUser
         * @property {string} first_name - 用户的名字
         * @property {string} last_name - 用户的姓氏
         * @property {number} id - 用户的ID
         * @property {string} [username] - 用户的用户名（可选）
         */

        /**
         * @type {string}
         */
        let cfToken = undefined;
        /**
         * @type {TelegramUser}
         */
        let tgUser = undefined;

        /**
         * @param {string} token
         */
        window.turnstileCallback = function (token) {
            cfToken = token;
            setLoginBtnDisable(false);
        };

        function setLoginBtnDisable(disabled) {
            document.getElementById('loginBtn').disabled = disabled;
            document.getElementById('tgLoginBtn').disabled = disabled;
        }

        /**
         * @param {boolean} open
         */
        function toggleTelegramModal(open) {
            const activeClassName = "is-active";
            const m = document.getElementById("telegramModal");
            if (open) {
                m.classList.add(activeClassName);
            } else {
                m.classList.remove(activeClassName);
            }
        }

        /**
         * @param {TelegramUser} user
         */
        function onTelegramAuth(user) {
            tgUser = user;
            if (!cfToken) {
                showErrorMessage("Please complete the Turnstile challenge first.");
                document.getElementById("telegramModal").classList.remove("is-active");
                return;
            }
            const formData = {
                provider_type: "Telegram",
                cf_token: cfToken,
                login_key: tgUser.id.toString(),
                data: tgUser
            };
            setLoginBtnDisable(true);
            toggleTelegramModal(false);
            loginReq(formData).then(payload => {
                if (!payload) {
                    return;
                }
                if (payload.code !== 0) {
                    showErrorMessage("Login failed. Please try again.");
                    return;
                }
                handleRedirect(payload.data.user, payload.data.next_url);
            }).finally(() => setLoginBtnDisable(false));
        }

        function nextUrl() {
            return document.getElementById('loginForm').dataset.nextUrl || "/auth";
        }

        function handleRedirect(user, next) {
            if (!user) {
                window.location.replace("/registration");
            } else {
                window.location.replace(next || nextUrl());
            }
        }

        document.getElementById('loginForm').addEventListener('submit', (event) => {
            const form = event.target;
            if (!form.checkValidity()) {
                event.preventDefault();
                return;
            }
            event.preventDefault();

            const formData = {
                provider_type: "EmailPassword",
                cf_token: cfToken,
                login_key: form.email.value,
                data: {
                    password: form.elements["password"].value,
                }
            };
            setLoginBtnDisable(true);
            loginReq(formData)
                .then(payload => {
                    if (!payload) {
                        return;
                    }
                    if (payload.code !== 0) {
                        showErrorMessage("Login failed. Check your credentials and try again.");
                    } else if (!payload.data.user) {
                        showErrorMessage("Invalid Credentials");
                    } else {
                        handleRedirect(payload.data.user, payload.data.next_url);
                    }
                })
                .finally(() => setLoginBtnDisable(false));
        });

        function loginReq(body) {
            const requestId = document.getElementById('loginForm').dataset.requestId;
            body.request_id = requestId || undefined;
            return fetch("/login", {
                method: "POST",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            }).then(async response => {
                if (!response.ok) {
                    throw new Error("HTTP " + response.status);
                }
                return response.json();
            }).catch(() => {
                showErrorMessage("Network Error");
                return null;
            });
        }

        function showErrorMessage(message) {
            document.getElementById("msgDiv").innerHTML = `
        <div class="notification is-danger">
            <button class="delete"></button>
            ${message}
        </div>
        `
        }

    </script>
</body>

</html>